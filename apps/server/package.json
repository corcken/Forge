{
  "name": "@descriptio-forge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Descriptio Forge backend - Fastify + tRPC + better-sqlite3 vault engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@descriptio-forge/shared": "*",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.1",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
